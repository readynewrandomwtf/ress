# ── Variables de entorno ──────────────────────────────────────────────────────
PORT=3000

# ── Firebase ──────────────────────────────────────────────────────────────────
# Local: ruta al archivo JSON de credenciales
FIREBASE_SERVICE_ACCOUNT=./theytoldya-firebase-adminsdk-fbsvc-e3cba1233a.json

# Azure: pegar el contenido COMPLETO del JSON como string (una sola línea)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# ── Panel de Control ──────────────────────────────────────────────────────────
PANEL_USER=tu_usuario
PANEL_PASS=tu_contraseña
PANEL_TOKEN=token_aleatorio_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local: usar * para desarrollo
# Producción: separar múltiples dominios con coma
# CORS_ORIGIN=https://tu-frontend.com,https://tu-panel.com
CORS_ORIGIN=*
